# --- Connection (required) ---------------------------------------------------
JIRA_URL=https://jira.example.com

# Auth: a Personal Access Token (recommended for Data Center) ...
JIRA_PERSONAL_TOKEN=
# ... or basic auth
#JIRA_USERNAME=
#JIRA_API_TOKEN=
#JIRA_PASSWORD=

# true | false | /path/to/ca-bundle.pem
#JIRA_SSL_VERIFY=true
# HTTP(S)_PROXY / NO_PROXY are honoured automatically.

# --- Toolsets ----------------------------------------------------------------
# default = admin, logs, integrations, issue_inspect, properties
# all     = everything. Add plugin toolsets explicitly:
#   scriptrunner, jmwe, structure, assets, automation, dvcs, sla, time_in_status, email
# Fewer tools = smaller prompt and better tool choice by the model.
#TOOLSETS=default,scriptrunner

# --- Issue guard (optional) ------------------------------------------------
# Confines every call to the issues matched by a JQL. When on, only tools that
# can be fully restricted by JQL are exposed (attachments, votes, remote links,
# issue properties, dev panel, SLA, Time in Status, JETI audit); admin and
# configuration tools are hidden. Any check failure denies the call.
# Static guard (works over stdio):
#JIRA_GUARD_JQL=project in (SOS, HR)
# Per-request guard from an HTTP header (e.g. LiteLLM static headers). The header
# is then required on every call; if both are set they are combined with AND.
#JIRA_GUARD_HEADER=x-jira-guard-jql

# --- Groovy endpoint ---------------------------------------------------------
# Where groovy/atlassian_admin.groovy is deployed as a ScriptRunner REST endpoint.
#JIRA_ADMIN_SR_PATH=/rest/scriptrunner/latest/custom/atlassianAdmin

# --- Performance -------------------------------------------------------------
# Request timeout, seconds (falls back to JIRA_TIMEOUT, then 60).
#JIRA_ADMIN_TIMEOUT=60
#JIRA_TIMEOUT=60
# Cache GET responses for N seconds (0 = off). Logs, audit and queues are never cached.
#JIRA_ADMIN_CACHE_TTL=120
# Max parallel requests to Jira.
#JIRA_ADMIN_MAX_CONCURRENCY=8
# Retries on 429/502/503/504 and network errors.
#JIRA_ADMIN_RETRIES=2

# --- Output ------------------------------------------------------------------
# JSON indent for tool results (0 = compact, cheapest for the model).
#JIRA_ADMIN_JSON_INDENT=0
# Longer results are cut and marked {"truncated": true, ...}.
#JIRA_ADMIN_MAX_RESPONSE_CHARS=100000
