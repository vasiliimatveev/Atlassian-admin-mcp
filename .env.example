# --- Connection (required) ---------------------------------------------------
JIRA_URL=https://jira.example.com

# Auth: a Personal Access Token (recommended for Data Center) ...
JIRA_PERSONAL_TOKEN=
# ... or basic auth
#JIRA_USERNAME=
#JIRA_API_TOKEN=
#JIRA_PASSWORD=

# true | false | /path/to/ca-bundle.pem
#JIRA_SSL_VERIFY=true
# HTTP(S)_PROXY / NO_PROXY are honoured automatically.

# --- Toolsets ----------------------------------------------------------------
# default = admin, logs, integrations, issue_inspect, properties
# all     = everything. Add plugin toolsets explicitly:
#   scriptrunner, jmwe, structure, assets, automation, dvcs, sla, time_in_status, email
# Fewer tools = smaller prompt and better tool choice by the model.
#TOOLSETS=default,scriptrunner

# --- Groovy endpoint ---------------------------------------------------------
# Where groovy/admin_analyst.groovy is deployed as a ScriptRunner REST endpoint.
#JIRA_ANALYST_SR_PATH=/rest/scriptrunner/latest/custom/adminAnalyst

# --- Performance -------------------------------------------------------------
# Request timeout, seconds (falls back to JIRA_TIMEOUT, then 60).
#JIRA_ANALYST_TIMEOUT=60
#JIRA_TIMEOUT=60
# Cache GET responses for N seconds (0 = off). Logs, audit and queues are never cached.
#JIRA_ANALYST_CACHE_TTL=120
# Max parallel requests to Jira.
#JIRA_ANALYST_MAX_CONCURRENCY=8
# Retries on 429/502/503/504 and network errors.
#JIRA_ANALYST_RETRIES=2

# --- Output ------------------------------------------------------------------
# JSON indent for tool results (0 = compact, cheapest for the model).
#JIRA_ANALYST_JSON_INDENT=0
# Longer results are cut and marked {"truncated": true, ...}.
#JIRA_ANALYST_MAX_RESPONSE_CHARS=100000
